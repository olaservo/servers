{
  "name": "@olaservo/server-list-resources-demo",
  "version": "0.1.0",
  "description": "Minimal MCP server demonstrating two ways to list a directory's resources: the currently-supported resources/read -> ResourceContents[] approach, and the proposed resources/directory/read -> Resource[] approach (backed by a forked SDK).",
  "license": "SEE LICENSE IN LICENSE",
  "author": "olaservo",
  "type": "module",
  "bin": {
    "mcp-server-list-resources-demo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "watch": "tsc --watch",
    "vendor:sdk": "cd ../../../../olaservo/typescript-sdk && npm pack --ignore-scripts --pack-destination \"$INIT_CWD/vendor\"",
    "start:stdio": "node dist/index.js stdio",
    "start:streamableHttp": "node dist/index.js streamableHttp",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "file:vendor/modelcontextprotocol-sdk-1.27.0.tgz",
    "cors": "^2.8.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8"
  }
}
