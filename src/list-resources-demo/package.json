{
  "name": "@olaservo/server-list-resources-demo",
  "version": "0.2.0",
  "description": "Reference MCP server for SEP-2640 (Skills Extension): serves Agent Skills over the base Resources primitive under the skill:// scheme, with a well-known skill://index.json and the io.modelcontextprotocol/skills capability. No new methods or schema.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "olaservo",
  "type": "module",
  "bin": {
    "mcp-server-list-resources-demo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "watch": "tsc --watch",
    "start:stdio": "node dist/index.js stdio",
    "start:streamableHttp": "node dist/index.js streamableHttp",
    "compare": "npm run build && node scripts/compare.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8"
  }
}
